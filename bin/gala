#!/usr/bin/env python3
"""Build iOS projects on your Mac, or sign and deliver an existing IPA privately."""

import argparse
import contextlib
import datetime as dt
import fcntl
import functools
import getpass
import hashlib
import html
import json
import os
from pathlib import Path
import plistlib
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
import uuid
import zipfile
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


DEFAULT_ROOT = "/Volumes/BlenderBuild/gala-engine"
RSYNC_PORT = 18730
API_PORT = 18731
OTA_PORT = 18732
OTA_TTL_SECONDS = 48 * 60 * 60
QUEUE_STALE_SECONDS = 120
RUNNING_STALE_SECONDS = 300
PROJECT_TTL_SECONDS = 21 * 24 * 60 * 60
SIMULATOR_MAX_AGE = 12 * 60 * 60
BUILD_HELPERS = {"xcodebuild", "swift-frontend", "XCBBuildService", "SWBBuildService", "SourceKitService"}
REPORT_LIMITS = {"log": 50, "crash": 20, "screenshot": 20}
RECIPE_PATH = ":".join((
    str(Path.home() / ".local/bin"), str(Path.home() / ".bun/bin"), str(Path.home() / ".maestro/bin"),
    "/opt/homebrew/opt/node@24/bin", "/opt/homebrew/bin", "/opt/homebrew/sbin",
    "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin",
))
APNS_LOCK = threading.Lock()
PUBLISH_LOCK = threading.Lock()
TAILNET_LOCK = threading.Lock()
TAILNET_CACHE = {"url": None, "until": 0}
SAFE_PATH = re.compile(r"^/[A-Za-z0-9_./-]+$")
SAFE_NAME = re.compile(r"^[a-z0-9][a-z0-9_-]*$")
EXCLUDES = (
    ".git/", ".gala/", ".direnv/", ".DS_Store",
    "node_modules/", ".expo/", "DerivedData/", ".build/", "build/",
)
WATCH_IGNORED = {".git", ".gala", ".direnv", "node_modules", ".expo", "DerivedData", ".build", "build"}


def fail(message):
    raise RuntimeError(message)


def checked(args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


@functools.cache
def is_local(host):
    """True when the Mac worker is this machine, so Gala can skip SSH to itself."""
    if host in ("local", "localhost"):
        return True
    if sys.platform != "darwin":
        return False
    resolved = subprocess.run(["ssh", "-G", host], capture_output=True, text=True, check=False)
    target = next((line.split(None, 1)[1] for line in resolved.stdout.splitlines()
                   if line.startswith("hostname ")), host).lower()
    names = {"localhost", "127.0.0.1", "::1", os.uname().nodename.lower(),
             os.uname().nodename.lower().removesuffix(".local")}
    tailscale = subprocess.run(["/opt/homebrew/bin/tailscale", "status", "--json"],
                               capture_output=True, text=True, check=False)
    if tailscale.returncode == 0:
        me = json.loads(tailscale.stdout).get("Self", {})
        names.update(address.lower() for address in me.get("TailscaleIPs", []))
        names.add(me.get("DNSName", "").rstrip(".").lower())
        names.add(me.get("HostName", "").lower())
    return target in names or target.split(".", 1)[0] in names


def remote(host, *args, check=True, timeout=None, **kwargs):
    if is_local(host):
        return subprocess.run([str(arg) for arg in args], check=check, timeout=timeout, **kwargs)
    command = " ".join(shlex.quote(str(arg)) for arg in args)
    # Job polling makes many short calls; share one SSH connection between them.
    multiplex = ["-o", "ControlMaster=auto", "-o", "ControlPath=~/.ssh/gala-%C", "-o", "ControlPersist=120"]
    return subprocess.run(["ssh", *multiplex, host, command], check=check, timeout=timeout, **kwargs)


def source_root(start, required=True):
    for directory in (start, *start.parents):
        if (directory / "ios-build.sh").is_file():
            return directory
    if required:
        fail("No ios-build.sh found here or in a parent directory")
    return start


def validate_options(options):
    if not re.fullmatch(r"[A-Za-z0-9_.@-]+", options.host):
        fail("Host must be a simple SSH name, such as macbook")
    if not SAFE_PATH.fullmatch(options.root) or ".." in Path(options.root).parts:
        fail("Remote root must be an absolute path without spaces or shell characters")


def project_paths(options, require_recipe=True):
    source = source_root(Path.cwd().resolve(), required=require_recipe)
    stem = re.sub(r"[^a-z0-9_-]+", "-", source.name.lower()).strip("-") or "app"
    origin = subprocess.run(["git", "-C", str(source), "config", "--get", "remote.origin.url"],
                            capture_output=True, text=True, check=False) if shutil.which("git") else None
    identity = str(source)
    if origin and origin.returncode == 0:
        top = subprocess.run(["git", "-C", str(source), "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, check=False)
        relative = os.path.relpath(source, top.stdout.strip()) if top.returncode == 0 else source.name
        identity = f"{origin.stdout.strip()}/{relative}"
    # Each client owns its mirror: simultaneous syncs from different machines must
    # not change the source tree underneath another client's queued build.
    identity = f"{os.uname().nodename}/{identity}/{source}"
    suffix = hashlib.sha256(identity.encode()).hexdigest()[:8]
    name = options.name or f"{stem}-{suffix}"
    if not SAFE_NAME.fullmatch(name):
        fail("Project name must contain lowercase letters, digits, _ or -")
    remote_project = f"projects/{name}"
    return source, name, remote_project


def service_request(host, method, path, check=True, **kwargs):
    return remote(host, "curl", "--fail-with-body", "-sS", "-X", method,
                  f"http://127.0.0.1:{API_PORT}/{path}", check=check, **kwargs)


def rsync_command(options, *args):
    env = os.environ.copy()
    if not is_local(options.host):
        env["RSYNC_CONNECT_PROG"] = f"ssh {options.host} nc 127.0.0.1 {RSYNC_PORT}"
    return checked(["rsync", *args], env=env)


def daemon_url(path):
    # Over SSH, RSYNC_CONNECT_PROG replaces the connection and the port is unused.
    return f"rsync://127.0.0.1:{RSYNC_PORT}/gala/{path}"


def prepare(options, remote_project):
    health = service_request(options.host, "GET", "health", capture_output=True, text=True)
    service_root = json.loads(health.stdout)["root"]
    if service_root != options.root:
        fail(f"Mac service uses {service_root}, not {options.root}")
    service_request(options.host, "POST", f"prepare/{remote_project.rsplit('/', 1)[-1]}", capture_output=True)


def sync(options, source, remote_project):
    command = ["-a", "--delete", "--filter=:- .gitignore"]
    if options.checksum:
        command.append("--checksum")
    if options.dry_run:
        command.extend(("--dry-run", "--itemize-changes"))
    for pattern in EXCLUDES:
        command.extend(("--exclude", pattern))
    command.extend((f"{source}/", daemon_url(f"{remote_project}/source/")))
    print(f"Syncing {source} to {options.host}:{options.root}/{remote_project}/source", flush=True)
    rsync_command(options, *command)


def source_snapshot(source):
    listing = subprocess.run(["git", "-C", str(source), "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
                             capture_output=True, check=False) if shutil.which("git") else None
    if listing and listing.returncode == 0:
        relative_paths = [Path(os.fsdecode(item)) for item in listing.stdout.split(b"\0") if item]
    else:
        relative_paths = []
        for directory, children, files in os.walk(source):
            children[:] = [child for child in children if child not in WATCH_IGNORED]
            relative_paths.extend((Path(directory) / file).relative_to(source) for file in files)
    snapshot = []
    for relative in relative_paths:
        if any(part in WATCH_IGNORED for part in relative.parts):
            continue
        path = source / relative
        try:
            stat = path.stat()
        except FileNotFoundError:
            continue
        if path.is_file():
            snapshot.append((str(relative), stat.st_size, stat.st_mtime_ns))
    return tuple(sorted(snapshot))


def client_watch(options):
    source = source_root(Path.cwd().resolve())
    command = [sys.executable, str(Path(__file__).resolve()), options.mode,
               "--host", options.host, "--root", options.root]
    if options.name:
        command.extend(("--name", options.name))
    if options.checksum:
        command.append("--checksum")
    if options.gate and options.mode in ("build", "run"):
        command.append("--gate")
    snapshot = source_snapshot(source)
    print(f"Watching {source}; action: {options.mode}. Press Ctrl-C to stop.", flush=True)
    while True:
        code = subprocess.run(command, cwd=source).returncode
        print(f"{options.mode} {'passed' if code == 0 else 'failed'}; waiting for edits...", flush=True)
        while True:
            time.sleep(options.interval)
            next_snapshot = source_snapshot(source)
            if next_snapshot != snapshot:
                snapshot = next_snapshot
                break
        while True:
            time.sleep(options.debounce)
            next_snapshot = source_snapshot(source)
            if next_snapshot == snapshot:
                break
            snapshot = next_snapshot


def client_doctor(options):
    validate_options(options)
    for program in ("rsync", "python3") if is_local(options.host) else ("ssh", "rsync", "python3"):
        if not shutil.which(program):
            fail(f"Missing local command: {program}")
    if is_local(options.host):
        print("Mac worker: this machine (no SSH)", flush=True)
    remote(options.host, "xcodebuild", "-version", timeout=20)
    remote(options.host, "xcrun", "--sdk", "iphoneos", "--show-sdk-version", timeout=20)
    # Xcode 26 ships the Metal compiler as a separate download; .metal sources fail without it.
    metal = remote(options.host, "xcrun", "-sdk", "iphoneos", "metal", "--version",
                   check=False, capture_output=True, text=True, timeout=30)
    if metal.returncode:
        fail("Metal compiler missing on the Mac; run there: xcodebuild -downloadComponent MetalToolchain")
    print("Metal compiler: ready")
    for label, path, minimum in (("Mac internal disk", "/System/Volumes/Data", 20), ("Gala storage", options.root, 20)):
        usage = remote(options.host, "df", "-k", path, capture_output=True, text=True, timeout=10)
        free = int(usage.stdout.splitlines()[-1].split()[3]) / 1024 / 1024
        print(f"{label}: {free:.0f} GB free" + (" (low; builds and Xcode updates may fail)" if free < minimum else ""))
    jobs = service_json(options.host, "GET", "queue")["jobs"]
    print(f"Build queue: {len(jobs)} job{'s' if len(jobs) != 1 else ''} active")
    health = service_request(options.host, "GET", "health", capture_output=True, text=True)
    # The service owns the storage root; a client flag cannot silently redirect it.
    service_root = json.loads(health.stdout)["root"]
    if service_root != options.root:
        fail(f"Mac service uses {service_root}, not {options.root}")
    print(f"Mac service: {service_root} (rsync ready)")
    remote(options.host, "curl", "-fsS", f"http://127.0.0.1:{OTA_PORT}/gala/projects.json",
           capture_output=True, text=True, timeout=10)
    print("Private OTA server: ready")


def connected_udids():
    for program in ("idevice_id", "idevicepair"):
        if not shutil.which(program):
            fail(f"Missing {program}; enter the Gala Engine Nix shell")
    if not Path("/run/usbmuxd").exists():
        fail("usbmuxd is not running; apply the ThinkPad NixOS device configuration")
    result = checked(["idevice_id", "-l"], capture_output=True, text=True)
    return sorted(line.strip() for line in result.stdout.splitlines() if line.strip())


def select_device(requested):
    devices = connected_udids()
    if requested:
        if requested not in devices:
            fail(f"Device {requested} is not connected over USB")
        return requested
    if not devices:
        fail("No iPhone or iPad is visible; connect and unlock it, then check usbmuxd")
    if len(devices) > 1:
        fail("More than one device is connected; pass --udid")
    return devices[0]


def device_action(options):
    if options.operation == "list":
        devices = connected_udids()
        if not devices:
            print("No iPhone or iPad is visible over USB")
        for udid in devices:
            info = subprocess.run(["ideviceinfo", "-u", udid, "-k", "DeviceName"],
                                  capture_output=True, text=True, check=False)
            name = info.stdout.strip() if info.returncode == 0 else "not paired"
            print(f"{udid}  {name}")
        return
    udid = select_device(options.udid)
    if options.operation == "pair":
        print("Unlock the device and accept its Trust This Computer prompt", flush=True)
        checked(["idevicepair", "-u", udid, "pair"])
    checked(["idevicepair", "-u", udid, "validate"])
    if options.operation == "doctor":
        checked(["ideviceinfo", "-u", udid, "-k", "ProductVersion"])
        checked(["idevicedevmodectl", "-u", udid, "list"])


def latest_ipa():
    source = source_root(Path.cwd().resolve())
    runs = source / ".gala" / "runs"
    if not runs.is_dir():
        fail("No Gala Engine builds found; run gala build or pass an IPA path")
    for run in sorted(runs.iterdir(), reverse=True):
        if run.is_dir():
            ipas = [p for p in run.rglob("*.ipa") if not p.stem.endswith("-signed")]
            if len(ipas) == 1:
                return ipas[0]
            if len(ipas) > 1:
                fail(f"Multiple IPAs in {run}; pass the one to deploy")
    fail("No unsigned IPA found; run gala build or pass an IPA path")


def require_deploy_tools():
    for program in ("zsign", "ideviceinstaller"):
        if not shutil.which(program):
            fail(f"Missing {program}; enter the Gala Engine Nix shell, or use gala deliver")


def client_deploy(options):
    require_deploy_tools()
    ipa = Path(options.ipa).expanduser().resolve() if options.ipa else latest_ipa()
    if not ipa.is_file() or ipa.suffix.lower() != ".ipa":
        fail(f"IPA not found: {ipa}")
    with zipfile.ZipFile(ipa) as archive:
        if archive.testzip():
            fail(f"IPA ZIP is corrupt: {ipa}")
    udid = select_device(options.udid)
    checked(["idevicepair", "-u", udid, "validate"])
    config_dir = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "gala-engine"
    p12 = Path(options.p12 or os.environ.get("GALA_P12", config_dir / "development.p12")).expanduser()
    profile = Path(options.profile or os.environ.get("GALA_PROFILE", config_dir / "development.mobileprovision")).expanduser()
    if not p12.is_file() or not profile.is_file():
        fail("Set --p12 and --profile (or GALA_P12 and GALA_PROFILE) to signing files")
    password = os.environ.get("GALA_P12_PASSWORD")
    if password is None:
        password_file = Path(os.environ.get("GALA_P12_PASSWORD_FILE", config_dir / "development.p12.password"))
        if password_file.is_file():
            password = password_file.read_text().strip()
        elif sys.stdin.isatty():
            password = getpass.getpass("P12 password: ")
        else:
            fail("Set GALA_P12_PASSWORD or GALA_P12_PASSWORD_FILE when running without a terminal")
    stem = ipa.stem.removesuffix("-unsigned")
    signed = ipa.with_name(f"{stem}-signed.ipa")
    checked(["zsign", "-k", str(p12), "-p", password, "-m", str(profile),
             "-o", str(signed), str(ipa)])
    print(f"Signed IPA: {signed}", flush=True)
    upgrade = subprocess.run(["ideviceinstaller", "-u", udid, "upgrade", str(signed)])
    if upgrade.returncode:
        print("Upgrade failed; trying an initial install", flush=True)
        checked(["ideviceinstaller", "-u", udid, "install", str(signed)])
    print(f"Deployed on {udid}")


def worker_prepare(project):
    project = Path(project)
    project.mkdir(parents=True, exist_ok=True)
    for child in ("source", "build", "runs", "incoming"):
        (project / child).mkdir(exist_ok=True)
    (project / "last-used").touch()


def clean_runs(runs):
    """Remove only Gala's completed run artifacts, leaving source and caches."""
    runs = Path(runs)
    if not runs.is_dir():
        return
    for child in runs.iterdir():
        if child.is_symlink() or child.is_file():
            child.unlink()
        elif child.is_dir():
            shutil.rmtree(child)


def inspect_ipas(run_dir):
    artifacts = []
    for ipa in sorted(run_dir.rglob("*.ipa")):
        if not ipa.is_file():
            continue
        with zipfile.ZipFile(ipa) as archive:
            corrupt = archive.testzip()
            if corrupt:
                fail(f"Corrupt IPA entry in {ipa}: {corrupt}")
            if not any(name.startswith("Payload/") and ".app/" in name for name in archive.namelist()):
                fail(f"IPA has no Payload/*.app bundle: {ipa}")
        sha = hashlib.sha256()
        with ipa.open("rb") as content:
            for chunk in iter(lambda: content.read(1024 * 1024), b""):
                sha.update(chunk)
        digest = sha.hexdigest()
        artifacts.append({"path": str(ipa.relative_to(run_dir)), "sha256": digest, "bytes": ipa.stat().st_size})
    return artifacts


def signing_profiles():
    directories = (Path.home() / "Library/MobileDevice/Provisioning Profiles",
                   Path.home() / "Library/Developer/Xcode/UserData/Provisioning Profiles")
    identities = checked(["security", "find-identity", "-v", "-p", "codesigning"],
                         capture_output=True, text=True).stdout
    available = set(re.findall(r"\b[A-F0-9]{40}\b", identities))
    for path in (profile for directory in directories for profile in directory.glob("*.mobileprovision")):
        decoded = subprocess.run(["security", "cms", "-D", "-i", str(path)],
                                 capture_output=True, check=False)
        if decoded.returncode:
            continue
        profile = plistlib.loads(decoded.stdout)
        for certificate in profile.get("DeveloperCertificates", []):
            identity = hashlib.sha1(certificate).hexdigest().upper()
            if identity in available and profile.get("ProvisionedDevices"):
                yield path, profile, identity


def profile_for_bundle(bundle_id, require_push=False):
    now = dt.datetime.now(dt.timezone.utc)
    candidates = []
    for path, profile, identity in signing_profiles():
        if require_push and profile.get("Entitlements", {}).get("aps-environment") not in ("development", "production"):
            continue
        expiry = profile.get("ExpirationDate")
        if expiry and expiry.replace(tzinfo=dt.timezone.utc) < now:
            continue
        app_id = profile.get("Entitlements", {}).get("application-identifier", "")
        if app_id.endswith("*") and bundle_id.startswith(app_id.split(".", 1)[1][:-1]):
            candidates.append((len(app_id), path, profile, identity))
        elif app_id.endswith("." + bundle_id):
            candidates.append((len(app_id) + 1000, path, profile, identity))
    if not candidates:
        requirement = " with Push Notifications enabled" if require_push else ""
        fail(f"No installed device provisioning profile{requirement} and matching keychain identity cover {bundle_id}")
    _, path, profile, identity = max(candidates, key=lambda item: item[0])
    return path, profile, identity


def bundle_info(bundle):
    info = plistlib.loads((bundle / "Info.plist").read_bytes())
    bundle_id = info.get("CFBundleIdentifier")
    if not bundle_id:
        fail(f"Missing CFBundleIdentifier in {bundle}")
    return info, bundle_id


def png_width(path):
    data = path.read_bytes()[:64]
    offset = 8
    # Xcode's CgBI-optimized icons put an extra chunk before IHDR.
    while offset + 16 <= len(data):
        length = int.from_bytes(data[offset:offset + 4], "big")
        if data[offset + 4:offset + 8] == b"IHDR":
            return int.from_bytes(data[offset + 8:offset + 12], "big")
        offset += 12 + length
    return 0


def extract_icon(app, destination):
    """Save the app's largest loose home screen icon as a standard PNG, if it has one."""
    info = plistlib.loads((app / "Info.plist").read_bytes())
    names = set(info.get("CFBundleIconFiles", []))
    for key in ("CFBundleIcons", "CFBundleIcons~ipad"):
        names.update(info.get(key, {}).get("CFBundlePrimaryIcon", {}).get("CFBundleIconFiles", []))
    candidates = [path for path in app.iterdir()
                  if path.suffix == ".png" and any(path.name.startswith(name) for name in names)]
    if not candidates:
        return False
    best = max(candidates, key=png_width)
    result = subprocess.run(["sips", "-s", "format", "png", str(best), "--out", str(destination)],
                            capture_output=True, check=False)
    return result.returncode == 0 and destination.is_file()


def code_sign(arguments, timeout=300):
    try:
        result = subprocess.run(["codesign", *arguments], capture_output=True, text=True,
                                timeout=timeout, check=False)
    except subprocess.TimeoutExpired:
        if timeout <= 20:
            fail("Mac keychain did not grant codesign access to the signing key within 15 seconds")
        fail(f"codesign timed out after {timeout} seconds")
    if result.returncode:
        fail(f"codesign failed: {result.stderr.strip() or result.stdout.strip()}")


def sign_bundle(bundle, scratch):
    info, bundle_id = bundle_info(bundle)
    profile_path, profile, identity = profile_for_bundle(bundle_id, bool(info.get("GalaRequiresPush")))
    shutil.copyfile(profile_path, bundle / "embedded.mobileprovision")
    entitlements = profile["Entitlements"].copy()
    team = profile["TeamIdentifier"][0]
    entitlements["application-identifier"] = f"{team}.{bundle_id}"
    entitlements["keychain-access-groups"] = [
        item.replace("*", bundle_id) for item in entitlements.get("keychain-access-groups", [])
    ]
    entitlement_path = scratch / f"{uuid.uuid4().hex}.plist"
    entitlement_path.write_bytes(plistlib.dumps(entitlements))
    code_sign(["--force", "--timestamp=none", "--sign", identity,
               "--entitlements", str(entitlement_path), str(bundle)])
    return info, len(profile["ProvisionedDevices"])


def write_json_atomic(path, data):
    temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex}")
    try:
        temporary.write_text(json.dumps(data) + "\n")
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def published_build(root, bundle_id):
    """Highest build number currently served for this app from any client mirror."""
    highest = 0
    for info_file in (root / "ota").glob("*/current.json"):
        try:
            info = json.loads(info_file.read_text())
        except (OSError, ValueError):
            continue
        if info.get("bundle_id") == bundle_id and str(info.get("version", "")).isdigit():
            highest = max(highest, int(info["version"]))
    return highest


def sign_ipa(root, ipa, counter_path=None, icon_path=None, extra_info=None):
    scratch = root / "signing" / uuid.uuid4().hex
    scratch.mkdir(parents=True)
    try:
        checked(["ditto", "-x", "-k", str(ipa), str(scratch)], capture_output=True)
        payload = scratch / "Payload"
        apps = list(payload.glob("*.app"))
        if len(apps) != 1:
            fail("Signing requires exactly one Payload/*.app")
        app = apps[0]
        app_info, app_id = bundle_info(app)
        build_number = None
        if counter_path:
            previous = int(counter_path.read_text()) if counter_path.is_file() else 0
            # Another checkout may have published this app, and old mirrors and deliveries
            # get cleaned up; never step its build number back.
            numbers_path = root / "build-numbers.json"
            numbers = json.loads(numbers_path.read_text()) if numbers_path.is_file() else {}
            previous = max(previous, published_build(root, app_id), numbers.get(app_id, 0))
            original = str(app_info.get("CFBundleVersion") or "0")
            major = int(original.split(".", 1)[0]) if original.split(".", 1)[0].isdigit() else 0
            build_number = max(previous, major) + 1
            app_info["CFBundleVersion"] = str(build_number)
        if counter_path or extra_info:
            app_info.update(extra_info or {})
            (app / "Info.plist").write_bytes(plistlib.dumps(app_info))
        if counter_path:
            for extension in app.rglob("*.appex"):
                extension_info, _ = bundle_info(extension)
                extension_info["CFBundleVersion"] = str(build_number)
                (extension / "Info.plist").write_bytes(plistlib.dumps(extension_info))
        _, _, identity = profile_for_bundle(app_id, bool(app_info.get("GalaRequiresPush")))
        probe = scratch / "codesign-probe"
        shutil.copyfile("/bin/echo", probe)
        probe.chmod(0o755)
        code_sign(["--force", "--timestamp=none", "--sign", identity, str(probe)], timeout=15)
        nested = sorted((p for p in app.rglob("*") if p.suffix in (".framework", ".dylib", ".appex")),
                        key=lambda p: len(p.parts), reverse=True)
        for path in nested:
            if path.suffix == ".appex":
                sign_bundle(path, scratch)
            else:
                code_sign(["--force", "--timestamp=none", "--sign", identity, str(path)])
        info, device_count = sign_bundle(app, scratch)
        code_sign(["--verify", "--deep", "--strict", str(app)])
        if icon_path:
            extract_icon(app, icon_path)
        signed = scratch / "signed.ipa"
        checked(["ditto", "-c", "-k", "--sequesterRsrc", "--keepParent", str(payload), str(signed)],
                capture_output=True)
        result = ipa.with_name(ipa.stem.removesuffix("-unsigned") + "-signed.ipa")
        os.replace(signed, result)
        if counter_path:
            counter_path.write_text(str(build_number) + "\n")
            numbers[app_id] = build_number
            write_json_atomic(numbers_path, numbers)
        return result, {
            "bundle_id": info["CFBundleIdentifier"],
            "title": info.get("CFBundleDisplayName") or info.get("CFBundleName") or app.stem,
            "version": str(info.get("CFBundleVersion") or "1"),
            "families": info.get("UIDeviceFamily", []),
            "profile_devices": device_count,
        }
    finally:
        shutil.rmtree(scratch)


def toolchain_identity():
    result = subprocess.run(["xcodebuild", "-version"], capture_output=True, text=True, check=False)
    return result.stdout.strip()


def source_fingerprint(source):
    """Hash the mirror's paths, sizes, and mtimes, for clients that send no fingerprint."""
    digest = hashlib.sha256()
    for directory, children, files in os.walk(source):
        children.sort()
        for name in sorted(files):
            path = Path(directory) / name
            try:
                stat = path.lstat()
            except FileNotFoundError:
                continue
            digest.update(f"{path.relative_to(source)}\0{stat.st_size}\0{stat.st_mtime_ns}\n".encode())
    return digest.hexdigest()


def job_env(root, project, run_dir, scratch):
    env = os.environ.copy()
    env.update({
        "GALA_ARTIFACT_DIR": str(run_dir),
        "GALA_BUILD_DIR": str(project / "build"),
        "GALA_JOBS": "2",
        "GALA_PLATFORM": "ios",
        # Keep compiler scratch and module caches off the Mac's small internal disk.
        "TMPDIR": f"{scratch}/",
        "CLANG_MODULE_CACHE_PATH": str(root / "cache" / "clang-module-cache"),
        "PATH": RECIPE_PATH,
    })
    return env


def run_step(entry, command, cwd, env, step_log, output):
    """Run one recipe in its own process group, copying output to both logs."""
    with open(step_log, "w", buffering=1) as log:
        process = subprocess.Popen(command, cwd=cwd, env=env, stdout=subprocess.PIPE,
                                   stderr=subprocess.STDOUT, text=True, bufsize=1,
                                   errors="replace", start_new_session=True)
        entry["process"] = process
        try:
            for line in process.stdout:
                log.write(line)
                output.write(line)
            return process.wait()
        except BaseException:
            stop_process_group(process)
            raise
        finally:
            process.stdout.close()
            entry["process"] = None


def stop_process_group(process):
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass


def run_job(root, entry):
    """Run a queued job's steps back to back in one build slot."""
    project = root / "projects" / entry["project"]
    run_dir = project / "runs" / entry["job"]
    run_dir.mkdir(parents=True, exist_ok=True)
    scratch = root / "tmp" / entry["job"]
    scratch.mkdir(parents=True, exist_ok=True)
    source = project / "source"
    env = job_env(root, project, run_dir, scratch)
    timings, skipped, code, artifacts = entry["timings"], entry["skipped"], 0, []
    pass_file = project / "test-pass.json"
    with open(run_dir / "output.log", "w", buffering=1, errors="replace") as output:
        try:
            for step in entry["steps"]:
                if entry["cancelled"]:
                    code = 130
                    break
                if step == "exec":
                    command, step_log = ["bash", "-c", entry["command"]], run_dir / "exec.log"
                else:
                    recipe = source / f"ios-{step}.sh"
                    command, step_log = ["bash", str(recipe)], run_dir / f"{step}.log"
                    if not recipe.is_file():
                        output.write(f"Missing recipe: {recipe}\n")
                        step_log.write_text(f"Missing recipe: {recipe}\n")
                        code = 1
                        break
                fingerprint = None
                if step == "test":
                    tree = entry["fingerprint"] or source_fingerprint(source)
                    fingerprint = hashlib.sha256(f"{tree}\0{toolchain_identity()}".encode()).hexdigest()
                if step == "test" and not entry["retest"] and pass_file.is_file():
                    previous = json.loads(pass_file.read_text())
                    if previous.get("fingerprint") == fingerprint:
                        output.write(f"Tests skipped: source unchanged since passing run {previous['job']}\n")
                        skipped.append("test")
                        continue
                output.write(f"==> {step}\n")
                started = time.monotonic()
                step_code = run_step(entry, command, source, env, step_log, output)
                timings[step] = round(time.monotonic() - started, 1)
                if step == "test" and step_code == 0:
                    pass_file.write_text(json.dumps({"fingerprint": fingerprint, "job": entry["job"]}) + "\n")
                if step_code:
                    code = 130 if entry["cancelled"] else step_code
                    output.write(f"{step} failed with exit code {step_code}\n")
                    break
            if code == 0 and "build" in entry["steps"]:
                try:
                    artifacts = inspect_ipas(run_dir)
                    if not artifacts:
                        fail("Recipe exited successfully but produced no IPA")
                except (RuntimeError, OSError, zipfile.BadZipFile) as error:
                    code = 1
                    output.write(f"IPA validation failed: {error}\n")
                    with open(run_dir / "build.log", "a") as log:
                        log.write(f"IPA validation failed: {error}\n")
        finally:
            shutil.rmtree(scratch, ignore_errors=True)
    # "kind" keeps older clients and the publish check working.
    manifest = {"job": entry["job"], "kind": entry["steps"][-1], "steps": entry["steps"], "exit_code": code,
                "artifacts": artifacts, "timings": timings, "skipped": skipped}
    (run_dir / "result.json").write_text(json.dumps(manifest, indent=2) + "\n")
    return code


class JobQueue:
    """Run one job at a time across every project; the Mac has 8 GB of RAM."""

    def __init__(self, root):
        self.root = root
        self.lock = threading.Condition()
        self.jobs = {}
        self.waiting = []
        self.current = None
        threading.Thread(target=self.work, daemon=True).start()

    def submit(self, project, job, steps, command=None, retest=False, fingerprint=None):
        if not re.fullmatch(r"[0-9TZ-]+[a-f0-9]{6}", job):
            fail("Invalid job ID")
        if not steps or any(step not in ("test", "build", "exec") for step in steps):
            fail("Invalid job steps")
        if ("exec" in steps) != bool(command):
            fail("An exec job needs exactly one command")
        if not (self.root / "projects" / project / "source").is_dir():
            fail(f"Unknown project {project}; sync it first")
        (self.root / "projects" / project / "last-used").touch()
        now = time.time()
        with self.lock:
            if job in self.jobs:
                fail("Duplicate job ID")
            self.jobs[job] = {"project": project, "job": job, "steps": steps, "command": command,
                              "retest": retest, "fingerprint": fingerprint,
                              "state": "queued", "submitted": now, "seen": now,
                              "process": None, "cancelled": False, "exit_code": None,
                              "timings": {}, "skipped": []}
            self.waiting.append(job)
            self.lock.notify_all()
            return self.describe(self.jobs[job])

    def describe(self, entry):
        """Summarize a job; the caller holds the lock."""
        now = time.time()
        state = {key: entry[key] for key in ("project", "job", "steps", "state", "exit_code", "timings", "skipped")}
        if entry["state"] == "queued":
            state["ahead"] = self.waiting.index(entry["job"]) + (1 if self.current else 0)
            state["waited"] = round(now - entry["submitted"], 1)
        else:
            state["ahead"] = 0
            state["waited"] = round(entry.get("started", now) - entry["submitted"], 1)
        if entry["state"] == "running":
            state["running_for"] = round(now - entry["started"], 1)
        if self.current and entry["job"] != self.current:
            running = self.jobs[self.current]
            state["blocked_by"] = f"{running['project']} ({'+'.join(running['steps'])})"
        return state

    def prune(self):
        """Drop jobs whose client stopped polling, and forget old results."""
        now = time.time()
        for job in list(self.waiting):
            if self.jobs[job]["seen"] < now - QUEUE_STALE_SECONDS:
                self.waiting.remove(job)
                self.jobs[job].update(state="done", exit_code=130, cancelled=True, finished=now)
        running = self.jobs.get(self.current) if self.current else None
        if running and running["seen"] < now - RUNNING_STALE_SECONDS and running["process"]:
            print(f"Job {self.current}: client gone for {RUNNING_STALE_SECONDS}s, stopping it", flush=True)
            running["cancelled"] = True
            stop_process_group(running["process"])
        for job, entry in list(self.jobs.items()):
            if entry["state"] == "done" and entry.get("finished", now) < now - 3600:
                del self.jobs[job]

    def status(self, job):
        with self.lock:
            self.prune()
            entry = self.jobs.get(job)
            if not entry:
                return None
            entry["seen"] = time.time()
            return self.describe(entry)

    def snapshot(self):
        with self.lock:
            self.prune()
            active = [job for job in (self.current, *self.waiting) if job]
            return [self.describe(self.jobs[job]) for job in active]

    def cancel(self, job):
        with self.lock:
            entry = self.jobs.get(job)
            if not entry or entry["state"] == "done":
                return False
            entry["cancelled"] = True
            if entry["state"] == "queued":
                self.waiting.remove(job)
                entry.update(state="done", exit_code=130, finished=time.time())
            elif entry["process"]:
                stop_process_group(entry["process"])
            self.lock.notify_all()
            return True

    def wait(self, job):
        """Block until a job finishes, for clients that predate polling."""
        with self.lock:
            while self.jobs[job]["state"] != "done":
                self.jobs[job]["seen"] = time.time()
                self.lock.wait(timeout=5)
            return self.jobs[job]["exit_code"]

    def work(self):
        while True:
            with self.lock:
                self.prune()
                while not self.waiting:
                    self.lock.wait(timeout=30)
                    self.prune()
                job = self.waiting.pop(0)
                entry = self.jobs[job]
                entry.update(state="running", started=time.time())
                self.current = job
            print(f"Job {job}: {entry['project']} {'+'.join(entry['steps'])}", flush=True)
            try:
                code = run_job(self.root, entry)
            except Exception as error:
                print(f"Job {job} crashed: {error}", flush=True)
                code = 1
            with self.lock:
                entry.update(state="done", exit_code=code, finished=time.time())
                self.current = None
                self.lock.notify_all()


def worker_publish(root, project_name, source):
    # Concurrent publishes would race on build numbers and the current.* swap.
    with PUBLISH_LOCK:
        return publish_locked(root, project_name, source)


def publish_locked(root, project_name, source):
    project = root / "projects" / project_name
    if source == "incoming":
        ipa = project / "incoming" / "current.ipa"
    else:
        if not re.fullmatch(r"[0-9TZ-]+[a-f0-9]{6}", source):
            fail("Invalid job ID")
        run = project / "runs" / source
        manifest = json.loads((run / "result.json").read_text())
        if "build" not in manifest.get("steps", [manifest.get("kind")]) or manifest.get("exit_code") != 0:
            fail("Only a successful build can be published")
        paths = manifest.get("artifacts", [])
        if len(paths) != 1:
            fail("Publish needs exactly one IPA; use gala publish <path> to select one")
        ipa = (run / paths[0]["path"]).resolve()
        if not ipa.is_relative_to(run.resolve()):
            fail("IPA path leaves the build run")
    if not ipa.is_file():
        fail(f"IPA not found: {ipa}")
    signed = None
    staged = None
    destination = root / "ota" / project_name
    destination.mkdir(parents=True, exist_ok=True)
    icon = destination / f".{uuid.uuid4().hex}.png"
    try:
        base_url = tailnet_base_url()
        # Apps that include GalaReporter.swift post logs, screenshots, and crashes here.
        extra_info = {"GalaReportURL": f"{base_url}/{project_name}/report"}
    except (subprocess.CalledProcessError, KeyError, ValueError, OSError):
        base_url, extra_info = None, None
    try:
        signed, metadata = sign_ipa(root, ipa, project / "build-number.txt", icon, extra_info)
        artifacts = inspect_ipas(signed.parent)
        matching = [artifact for artifact in artifacts if artifact["path"] == signed.name]
        if len(matching) != 1:
            fail("Signed IPA validation failed")
        artifact = matching[0]
        staged = destination / f".{uuid.uuid4().hex}.ipa"
        os.link(signed, staged)
        os.replace(staged, destination / "current.ipa")
        if icon.is_file():
            os.replace(icon, destination / "icon.png")
        else:
            (destination / "icon.png").unlink(missing_ok=True)
        write_json_atomic(destination / "current.json", {
            "sha256": artifact["sha256"], "bytes": artifact["bytes"],
            "published_at": time.time(), **metadata,
        })
    finally:
        icon.unlink(missing_ok=True)
        if staged:
            staged.unlink(missing_ok=True)
        if signed:
            signed.unlink(missing_ok=True)
        if source == "incoming":
            ipa.unlink(missing_ok=True)
    # Push results stay in the Mac's status files; the client only needs to know delivery happened.
    try:
        notify_subscribers(root, project_name, metadata)
    except Exception as error:
        print(f"Build notification failed: {error}", flush=True)
    urls = {"install_url": f"{base_url}/{project_name}/",
            "ipa_url": f"{base_url}/{project_name}/current.ipa?sha256={artifact['sha256']}"} if base_url else {}
    return {"project": project_name, "sha256": artifact["sha256"], "bytes": artifact["bytes"], **urls, **metadata}


def apns_ready(root):
    return all((root / name).is_file() for name in
               ("apns.js", "apns/apns-cert.pem", "apns/apns-key.pem"))


def save_apns_subscriptions(root, entries):
    temporary = root / f".apns-subscriptions-{uuid.uuid4().hex}.json"
    try:
        with open(temporary, "x", opener=lambda path, flags: os.open(path, flags, 0o600)) as output:
            output.write(json.dumps(entries) + "\n")
        os.replace(temporary, root / "apns-subscriptions.json")
    finally:
        temporary.unlink(missing_ok=True)


def register_apns(root, request):
    token = request.get("token", "")
    environment = request.get("environment")
    device = request.get("device", "")
    if (not isinstance(token, str) or not re.fullmatch(r"[a-fA-F0-9]{2,512}", token)
            or len(token) % 2 or environment not in ("development", "production")
            or not isinstance(device, str) or not re.fullmatch(r"[a-fA-F0-9-]{36}", device)):
        fail("Invalid APNs registration")
    entry = {"token": token.lower(), "environment": environment, "device": device,
             "registered_at": time.time()}
    path = root / "apns-subscriptions.json"
    with APNS_LOCK:
        current = json.loads(path.read_text()) if path.is_file() else []
        current = [item for item in current if not
                   (item["environment"] == environment and
                    (item["device"] == device or item["token"] == entry["token"]))]
        if len(current) >= 100:
            fail("Too many APNs devices")
        save_apns_subscriptions(root, [*current, entry])


def notify_apns(root, payload):
    path = root / "apns-subscriptions.json"
    report = {"at": time.time(), "registered": 0, "sent": 0, "failed": 0}
    try:
        with APNS_LOCK:
            entries = json.loads(path.read_text()) if path.is_file() else []
        report.update({"registered": len(entries), "failed": len(entries)})
        if not entries:
            return report
        result = subprocess.run(["/opt/homebrew/opt/node@24/bin/node", str(root / "apns.js"),
                                 str(root), json.dumps(payload)],
                                capture_output=True, text=True, timeout=30, check=False)
        if result.returncode:
            fail("APNs sender failed; check certificates and subscriptions")
        parsed = json.loads(result.stdout)
        report.update({key: parsed[key] for key in ("registered", "sent", "failed")})
        report["reasons"] = [item["reason"] for item in parsed["results"] if item["status"] != "sent"]
        expired = {(item["token"], item["environment"], item["registered_at"])
                   for item in parsed["results"] if item["status"] == "expired"}
        if expired:
            with APNS_LOCK:
                current = json.loads(path.read_text())
                save_apns_subscriptions(root, [item for item in current if
                    (item["token"], item["environment"], item["registered_at"]) not in expired])
    except (OSError, subprocess.TimeoutExpired, ValueError, KeyError, RuntimeError) as error:
        report["error"] = str(error)
        report["failed"] = max(1, report["failed"])
    (root / "apns-status.json").write_text(json.dumps(report) + "\n")
    return report


def notify_subscribers(root, project, metadata):
    payload = {"title": f"{metadata['title']} update ready",
               "body": "Tap to install the latest Gala build.",
               "project": project, "url": f"/gala/{project}/?install=1"}
    native = notify_apns(root, payload)
    web = notify_web_subscribers(root, payload)
    return {key: native.get(key, 0) + web.get(key, 0) for key in ("registered", "sent", "failed")}


def notify_web_subscribers(root, payload):
    subscriptions = root / "subscriptions.json"
    if not subscriptions.is_file():
        return {"registered": 0, "sent": 0, "failed": 0}
    report = {"at": time.time(), "registered": 0, "sent": 0, "failed": 0}
    try:
        count = len(json.loads(subscriptions.read_text()))
        report.update(registered=count, failed=count)
        result = subprocess.run(["/opt/homebrew/opt/node@24/bin/node", str(root / "webpush.js"),
                                 "send", str(root), json.dumps(payload)],
                                capture_output=True, text=True, timeout=30, check=False)
        report["exit_code"] = result.returncode
        if result.returncode == 0:
            parsed = json.loads(result.stdout)
            report.update({key: parsed[key] for key in ("sent", "failed", "registered")})
            prune_web_subscriptions(subscriptions, parsed["results"])
        else:
            report["error"] = result.stderr.strip()
    except (OSError, subprocess.TimeoutExpired, ValueError, KeyError) as error:
        report.update({"exit_code": 1, "error": str(error)})
    (root / "push-status.json").write_text(json.dumps(report) + "\n")
    return {key: report.get(key, 0) for key in ("registered", "sent", "failed")}


def prune_web_subscriptions(path, results):
    expired = {item["endpoint"] for item in results if item.get("status") == "expired"}
    if expired:
        current = json.loads(path.read_text())
        write_json_atomic(path, [item for item in current if item["subscription"]["endpoint"] not in expired])
        os.chmod(path, 0o600)


def ota_expired(ipa):
    try:
        return ipa.stat().st_mtime < time.time() - OTA_TTL_SECONDS
    except FileNotFoundError:
        return True


def current_delivery(directory):
    if ota_expired(directory / "current.ipa"):
        return None
    try:
        return json.loads((directory / "current.json").read_text())
    except (OSError, ValueError):
        return None


def expire_ota(root):
    ota = root / "ota"
    if not ota.is_dir():
        return
    for project in ota.iterdir():
        if project.is_dir() and SAFE_NAME.fullmatch(project.name):
            ipa = project / "current.ipa"
            if ota_expired(ipa):
                ipa.unlink(missing_ok=True)
                (project / "current.json").unlink(missing_ok=True)
                (project / "icon.png").unlink(missing_ok=True)
            if not any(project.iterdir()):
                project.rmdir()


def project_last_used(project):
    marker = project / "last-used"
    return (marker if marker.exists() else project).stat().st_mtime


def collect_stale_projects(root, queue=None):
    """Remove mirrors, caches, and reports for projects no client has used in weeks."""
    busy = {item["project"] for item in queue.snapshot()} if queue else set()
    cutoff = time.time() - PROJECT_TTL_SECONDS
    removed = []
    for project in (root / "projects").glob("*"):
        if (project.is_dir() and SAFE_NAME.fullmatch(project.name) and project.name not in busy
                and project_last_used(project) < cutoff):
            for path in (project, root / "ota" / project.name, root / "reports" / project.name):
                shutil.rmtree(path, ignore_errors=True)
            removed.append(project.name)
    if removed:
        print(f"Removed unused project mirrors: {', '.join(removed)}", flush=True)
    return removed


def prune_reports(root):
    for project in (root / "reports").glob("*"):
        reports = sorted(project.iterdir(), key=lambda path: path.name, reverse=True)
        for kind, limit in REPORT_LIMITS.items():
            for path in [path for path in reports if path.stem.endswith(f"-{kind}")][limit:]:
                path.unlink(missing_ok=True)


def trim_log(path, limit=20 * 1024 * 1024):
    """Keep the newest part of the service log; launchd or nohup appends to it."""
    try:
        if path.stat().st_size <= limit:
            return
        with open(path, "r+b") as log:
            log.seek(-limit // 2, os.SEEK_END)
            tail = log.read()
            log.seek(0)
            log.write(tail)
            log.truncate()
    except OSError:
        pass


def reset_cache_for_toolchain(root):
    cache = root / "cache"
    marker = cache / "toolchain.txt"
    identity = toolchain_identity()
    if not marker.is_file() or marker.read_text() != identity:
        shutil.rmtree(cache / "clang-module-cache", ignore_errors=True)
        cache.mkdir(parents=True, exist_ok=True)
        marker.write_text(identity)


def booted_simulators():
    result = checked(["xcrun", "simctl", "list", "devices", "booted", "-j"],
                     capture_output=True, text=True, timeout=30)
    return [device for devices in json.loads(result.stdout)["devices"].values()
            for device in devices if device.get("state") == "Booted"]


def process_snapshot(pid=None):
    selection = ["-p", str(pid)] if pid is not None else ["-ax"]
    result = subprocess.run(["ps", *selection, "-o", "pid=,ppid=,uid=,lstart=,time=,state=,comm="],
                            capture_output=True, text=True, timeout=10, check=False)
    if result.returncode and pid is None:
        fail(f"Cannot inspect build helpers: {result.stderr.strip()}")
    processes = []
    for line in result.stdout.splitlines():
        fields = line.split(None, 10)
        if len(fields) != 11:
            continue
        try:
            started = dt.datetime.strptime(" ".join(fields[3:8]), "%a %b %d %H:%M:%S %Y").timestamp()
            processes.append({"pid": int(fields[0]), "ppid": int(fields[1]), "uid": int(fields[2]),
                              "started": started, "cpu": fields[8], "state": fields[9], "command": fields[10]})
        except ValueError:
            continue
    return processes


def reap_idle_resources(root, queue=None):
    """Reap old simulators and orphaned helpers while the build queue is idle."""
    if sys.platform != "darwin":
        return
    # Hold the queue lock so a job cannot start between the idle check and shutdown.
    with queue.lock if queue else contextlib.nullcontext():
        if queue and (queue.current or queue.waiting):
            return
        # Signing can also use build helpers. Do not interrupt a publish.
        if not PUBLISH_LOCK.acquire(blocking=False):
            return
        try:
            reap_resources_locked(root)
        finally:
            PUBLISH_LOCK.release()


def reap_resources_locked(root):
    now = time.time()
    marker = root / "reaper-state.json"
    try:
        previous = json.loads(marker.read_text()) if marker.is_file() else {}
    except (OSError, ValueError):
        previous = {}
    seen = {}
    stopped = False
    for device in booted_simulators():
        udid = device["udid"]
        if not re.fullmatch(r"[A-Fa-f0-9-]{36}", udid):
            continue
        try:
            booted = dt.datetime.fromisoformat(device["lastBootedAt"].replace("Z", "+00:00")).timestamp()
        except (KeyError, ValueError, TypeError):
            booted = previous.get("simulators", {}).get(udid, now)
        seen[udid] = booted
        if now - booted >= SIMULATOR_MAX_AGE:
            result = subprocess.run(["xcrun", "simctl", "shutdown", udid],
                                    capture_output=True, text=True, timeout=30, check=False)
            if result.returncode == 0:
                print(f"Reaper: shut down simulator {udid} ({device.get('name', '')}), booted {int((now - booted) / 3600)}h", flush=True)
                seen.pop(udid)
                stopped = True
            else:
                print(f"Reaper: simulator {udid} shutdown failed: {result.stderr.strip()}", flush=True)
    # Recheck simctl before closing the app, since other sessions can boot devices.
    close_simulator = stopped and not booted_simulators()
    processes = process_snapshot()
    helpers = {}
    for process in processes:
        if process["uid"] != os.getuid():
            continue
        name = Path(process["command"]).name
        key = f"{process['pid']}:{process['started']}"
        helper = name in BUILD_HELPERS and process["ppid"] == 1
        if helper:
            helpers[key] = process["cpu"]
        idle = (helper and process["state"].startswith(("S", "I"))
                and now - process["started"] >= SIMULATOR_MAX_AGE
                and previous.get("helpers", {}).get(key) == process["cpu"]
                and not any(child["ppid"] == process["pid"] and not child["state"].startswith("Z")
                            for child in processes))
        simulator = (close_simulator and name == "Simulator"
                     and "Simulator.app/Contents/MacOS/Simulator" in process["command"])
        if not (idle or simulator):
            continue
        # A recycled PID or newly active process must survive the scan.
        current = process_snapshot(process["pid"])
        if not current or any(current[0][field] != process[field]
                              for field in ("started", "command", "ppid", "cpu")):
            continue
        if simulator and booted_simulators():
            continue
        try:
            os.kill(process["pid"], signal.SIGTERM)
        except ProcessLookupError:
            continue
        print(f"Reaper: terminated {name} PID {process['pid']}" +
              (" after all simulators shut down" if simulator else " (orphaned, idle, older than 12h)"), flush=True)
        helpers.pop(key, None)
    write_json_atomic(marker, {"simulators": seen, "helpers": helpers})


def housekeeping(root, queue=None):
    expire_ota(root)
    collect_stale_projects(root, queue)
    prune_reports(root)
    trim_log(root / "service.log")
    try:
        reap_idle_resources(root, queue)
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        print(f"Resource cleanup failed: {error}", flush=True)


def expiration_loop(root, queue):
    while True:
        time.sleep(3600)
        try:
            housekeeping(root, queue)
        except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
            print(f"Housekeeping failed: {error}", flush=True)


def tailnet_base_url():
    with TAILNET_LOCK:
        if time.monotonic() >= TAILNET_CACHE["until"]:
            status = checked(["/opt/homebrew/bin/tailscale", "status", "--json"],
                             capture_output=True, text=True, timeout=10)
            hostname = json.loads(status.stdout)["Self"]["DNSName"].rstrip(".")
            if not hostname:
                fail("Tailscale has no DNS name")
            TAILNET_CACHE.update(url=f"https://{hostname}/gala", until=time.monotonic() + 60)
        return TAILNET_CACHE["url"]


def ota_projects(root):
    projects = []
    for directory in (root / "ota").glob("*"):
        info = current_delivery(directory)
        if info is None:
            continue
        icon = (f"{directory.name}/icon.png?v={info['sha256'][:16]}"
                if (directory / "icon.png").is_file() else None)
        projects.append({"project": directory.name, "icon": icon,
                         **{key: info[key] for key in ("title", "version", "sha256", "bytes", "published_at", "bundle_id")}})
    projects.sort(key=lambda item: item["published_at"], reverse=True)
    newest = {}
    for item in projects:
        newest.setdefault(item["bundle_id"], item)
    return list(newest.values())


def ota_manifest(base_url, project, info, token, has_icon):
    ipa_url = f"{base_url}/{project}/current.ipa?sha256={info['sha256']}"
    if re.fullmatch(r"[a-f0-9]{32}", token):
        ipa_url += f"&attempt={token}"
    if has_icon:
        small = large = f"{base_url}/{project}/icon.png?v={info['sha256'][:16]}"
    else:
        small, large = f"{base_url}/icon-57.png", f"{base_url}/icon-512.png"
    return plistlib.dumps({"items": [{"assets": [
        {"kind": "software-package", "sha256": info["sha256"], "url": ipa_url},
        {"kind": "display-image", "url": small}, {"kind": "full-size-image", "url": large}],
        "metadata": {"bundle-identifier": info["bundle_id"], "bundle-version": info["version"],
                     "kind": "software", "platform-identifier": "com.apple.platform.iphoneos",
                     "title": info["title"]}}]})


def ota_service(root):
    script = root / "webpush.js"
    vapid = None
    if script.is_file():
        setup = subprocess.run(["/opt/homebrew/opt/node@24/bin/node", str(script), "init", str(root)],
                               capture_output=True, text=True, check=False)
        if setup.returncode == 0:
            vapid = json.loads(setup.stdout)["publicKey"]
    subscription_lock = threading.Lock()
    attempt_lock = threading.Lock()
    attempts = {}

    def new_attempt(project, info, token=""):
        # The web dashboard picks its own token so it can open itms-services
        # inside the tap handler; Safari drops the handoff after an await.
        if not re.fullmatch(r"[a-f0-9]{32}", token):
            token = uuid.uuid4().hex
        with attempt_lock:
            for old, value in list(attempts.items()):
                if value["created"] < time.time() - 3600:
                    del attempts[old]
            current = attempts.get(token)
            if not current or current["project"] != project or current["sha256"] != info["sha256"]:
                attempts[token] = {"project": project, "sha256": info["sha256"],
                                   "created": time.time(), "stage": "ready",
                                   "sent": 0, "total": info["bytes"]}
        return token

    def install_links(base_url, project, info, token):
        manifest_url = f"{base_url}/{project}/manifest.plist?sha256={info['sha256']}&attempt={token}"
        install_url = "itms-services://?action=download-manifest&url=" + urllib.parse.quote(manifest_url, safe="")
        return {"attempt": token, "install_url": install_url,
                "status_url": f"{base_url}/{project}/status.json?attempt={token}",
                "web_url": f"{base_url}/{project}/"}

    def update_attempt(token, project, sha256, **changes):
        if not re.fullmatch(r"[a-f0-9]{32}", token):
            return
        with attempt_lock:
            attempt = attempts.get(token)
            if attempt and attempt["project"] == project and attempt["sha256"] == sha256:
                attempt.update(changes)

    class Handler(BaseHTTPRequestHandler):
        def reply(self, status, body, content_type="application/json", head_only=False, cache="no-store"):
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", cache)
            self.end_headers()
            if not head_only:
                self.wfile.write(body)

        def send_content(self, head_only=False):
            parsed = urllib.parse.urlsplit(self.path)
            query = urllib.parse.parse_qs(parsed.query)
            token = query.get("attempt", [""])[0]
            pieces = parsed.path.strip("/").split("/")
            if pieces[:1] == ["gala"]:
                pieces = pieces[1:]
            if pieces in ([], [""]):
                self.reply(200, (root / "dashboard.html").read_bytes(), "text/html; charset=utf-8", head_only)
                return
            if len(pieces) == 1 and pieces[0] in ("sw.js", "manifest.webmanifest", "icon.svg", "icon-57.png", "icon-512.png"):
                types = {"sw.js": "text/javascript", "manifest.webmanifest": "application/manifest+json",
                         "icon.svg": "image/svg+xml", "icon-57.png": "image/png", "icon-512.png": "image/png"}
                self.reply(200, (root / pieces[0]).read_bytes(), types[pieces[0]], head_only)
                return
            if pieces == ["config.json"]:
                if not vapid:
                    self.send_error(503, "Web Push is not configured")
                else:
                    self.reply(200, json.dumps({"publicKey": vapid}).encode(), head_only=head_only)
                return
            if pieces == ["apns", "config.json"]:
                self.reply(200, json.dumps({"available": apns_ready(root)}).encode(), head_only=head_only)
                return
            if pieces == ["projects.json"]:
                self.reply(200, json.dumps(ota_projects(root)).encode(), head_only=head_only)
                return
            if len(pieces) == 1:
                pieces.append("")
            if len(pieces) != 2 or not SAFE_NAME.fullmatch(pieces[0]) or pieces[1] not in (
                    "current.ipa", "manifest.plist", "status.json", "icon.png", ""):
                self.send_error(404)
                return
            project = pieces[0]
            ipa = root / "ota" / project / "current.ipa"
            info = current_delivery(ipa.parent)
            if info is None:
                self.send_error(404)
                return
            icon = ipa.parent / "icon.png"
            if pieces[1] == "icon.png":
                if not icon.is_file():
                    self.send_error(404)
                    return
                # Icon URLs carry the build hash, so a new build gets a new URL.
                self.reply(200, icon.read_bytes(), "image/png", head_only, "private, max-age=604800")
                return
            if pieces[1] == "status.json":
                with attempt_lock:
                    attempt = attempts.get(token)
                    if not attempt or attempt["project"] != project:
                        self.send_error(404)
                        return
                    state = {key: attempt[key] for key in ("stage", "sent", "total")}
                    if attempt["sha256"] != info["sha256"]:
                        state["stage"] = "superseded"
                self.reply(200, json.dumps(state).encode(), head_only=head_only)
                return
            requested_sha = query.get("sha256", [""])[0]
            if requested_sha and requested_sha != info["sha256"]:
                self.send_error(409, "This build was replaced")
                return
            if pieces[1] != "current.ipa":
                try:
                    base_url = tailnet_base_url()
                except (subprocess.CalledProcessError, KeyError, ValueError):
                    self.send_error(503, "Tailscale is not ready")
                    return
                if pieces[1] == "manifest.plist":
                    if not head_only and re.fullmatch(r"[a-f0-9]{32}", token):
                        new_attempt(project, info, token)
                        update_attempt(token, project, info["sha256"], stage="manifest")
                    body = ota_manifest(base_url, project, info, token, icon.is_file())
                    content_type = "application/xml"
                else:
                    token = new_attempt(project, info)
                    install = install_links(base_url, project, info, token)["install_url"]
                    page = (root / "install.html").read_text()
                    icon_url = f"icon.png?v={info['sha256'][:16]}" if icon.is_file() else ""
                    body = (page.replace("@TITLE@", html.escape(info["title"], quote=True))
                            .replace("@VERSION@", html.escape(info["version"], quote=True))
                            .replace("@INSTALL_URL@", html.escape(install, quote=True))
                            .replace("@ICON@", html.escape(icon_url, quote=True))
                            .replace("@ATTEMPT@", token)).encode()
                    content_type = "text/html; charset=utf-8"
                self.reply(200, body, content_type, head_only)
                return
            self.send_ipa(ipa, project, info, token, head_only)

        def send_ipa(self, ipa, project, info, token, head_only):
            with ipa.open("rb") as content:
                size = os.fstat(content.fileno()).st_size
                self.send_response(200)
                self.send_header("Content-Type", "application/octet-stream")
                self.send_header("Content-Disposition", 'attachment; filename="current.ipa"')
                self.send_header("Content-Length", str(size))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                if not head_only:
                    update_attempt(token, project, info["sha256"], stage="downloading", sent=0, total=size)
                    sent = 0
                    try:
                        for chunk in iter(lambda: content.read(64 * 1024), b""):
                            self.wfile.write(chunk)
                            sent += len(chunk)
                            update_attempt(token, project, info["sha256"], sent=sent)
                    except (BrokenPipeError, ConnectionResetError):
                        update_attempt(token, project, info["sha256"], stage="interrupted")
                        return
                    update_attempt(token, project, info["sha256"], stage="transferred", sent=sent)

        def save_report(self, project, kind):
            """Store a log, screenshot, or crash diagnostic posted by an installed app."""
            extension = {"log": "log", "crash": "json", "screenshot": "png"}.get(kind)
            length = int(self.headers.get("Content-Length", "0"))
            if not extension or not (root / "projects" / project).is_dir():
                self.reply(404, b'{"error":"unknown project or report kind"}\n')
                return
            if not 0 < length <= 16 * 1024 * 1024:
                self.reply(413, b'{"error":"reports must be 1 byte to 16 MB"}\n')
                return
            directory = root / "reports" / project
            directory.mkdir(parents=True, exist_ok=True)
            stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
            temporary = directory / f".{uuid.uuid4().hex}"
            temporary.write_bytes(self.rfile.read(length))
            os.replace(temporary, directory / f"{stamp}-{kind}.{extension}")
            prune_reports(root)
            self.reply(200, b'{"ok":true}\n')

        def do_GET(self):
            self.send_content()

        def do_HEAD(self):
            self.send_content(head_only=True)

        def do_POST(self):
            parsed = urllib.parse.urlsplit(self.path)
            pieces = parsed.path.strip("/").split("/")
            if pieces[:1] == ["gala"]:
                pieces = pieces[1:]
            if pieces == ["apns", "subscribe"]:
                if not apns_ready(root):
                    self.reply(503, b'{"error":"Native push is not configured"}\n')
                    return
                try:
                    length = int(self.headers.get("Content-Length", "0"))
                    if not 0 < length <= 4096:
                        fail("Invalid APNs registration size")
                    request = json.loads(self.rfile.read(length))
                    if not isinstance(request, dict):
                        fail("Invalid APNs registration")
                    register_apns(root, request)
                    self.reply(200, b'{"ok":true}\n')
                except (KeyError, ValueError, TypeError, RuntimeError) as error:
                    self.reply(400, json.dumps({"error": str(error)}).encode())
                return
            if len(pieces) == 2 and SAFE_NAME.fullmatch(pieces[0]) and pieces[1] == "attempt":
                project = pieces[0]
                ipa = root / "ota" / project / "current.ipa"
                info = current_delivery(ipa.parent)
                if info is None:
                    self.send_error(404)
                    return
                try:
                    base_url = tailnet_base_url()
                except (subprocess.CalledProcessError, KeyError, ValueError, OSError):
                    self.send_error(503, "Gala install is unavailable")
                    return
                requested = urllib.parse.parse_qs(parsed.query).get("attempt", [""])[0]
                token = new_attempt(project, info, requested)
                body = json.dumps(install_links(base_url, project, info, token)).encode()
                self.reply(200, body)
                return
            if len(pieces) == 2 and SAFE_NAME.fullmatch(pieces[0]) and pieces[1] == "report":
                self.save_report(pieces[0], urllib.parse.parse_qs(parsed.query).get("kind", [""])[0])
                return
            if pieces != ["subscribe"]:
                self.send_error(404)
                return
            try:
                length = int(self.headers.get("Content-Length", "0"))
                if not 0 < length <= 8192:
                    fail("Invalid subscription size")
                request = json.loads(self.rfile.read(length))
                subscription = request["subscription"]
                endpoint = subscription["endpoint"]
                keys = subscription["keys"]
                if not endpoint.startswith("https://") or not keys.get("p256dh") or not keys.get("auth"):
                    fail("Invalid push subscription")
                entry = {"subscription": subscription, "device": str(request.get("device", ""))[:300],
                         "registered_at": time.time()}
                path = root / "subscriptions.json"
                with subscription_lock:
                    current = json.loads(path.read_text()) if path.is_file() else []
                    current = [item for item in current if item["subscription"]["endpoint"] != endpoint]
                    current.append(entry)
                    temporary = root / f".subscriptions-{uuid.uuid4().hex}.json"
                    temporary.write_text(json.dumps(current, indent=2) + "\n")
                    os.chmod(temporary, 0o600)
                    os.replace(temporary, path)
                self.reply(200, b'{"ok":true}\n')
            except (KeyError, ValueError, TypeError, RuntimeError) as error:
                self.reply(400, json.dumps({"error": str(error)}).encode())

    ThreadingHTTPServer(("127.0.0.1", OTA_PORT), Handler).serve_forever()


def mac_service(root):
    root = Path(root)
    root.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=root) as probe:
        probe.write(b"ok")
        probe.flush()
    # Python opens its own log after its volume access check. launchd cannot open
    # this USB log before starting the process, even when Python has access.
    log_fd = os.open(root / "service.log", os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    try:
        os.dup2(log_fd, 1)
        os.dup2(log_fd, 2)
    finally:
        os.close(log_fd)
    class Handler(BaseHTTPRequestHandler):
        def respond(self, status, data):
            body = (json.dumps(data) + "\n").encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def job_status(self, job, query):
            """Long-poll until the job has new output or changes state, then return both."""
            offset = int(query.get("offset", ["0"])[0])
            begun = time.monotonic()
            deadline = begun + min(float(query.get("wait", ["0"])[0]), 20)
            state = queue.status(job)
            if not state:
                return None
            log = root / "projects" / state["project"] / "runs" / job / "output.log"
            while time.monotonic() < deadline:
                size = log.stat().st_size if log.is_file() else 0
                # Hold new output briefly so a chatty build doesn't cost one SSH call per line.
                if (size > offset and time.monotonic() - begun >= 1) or state["state"] == "done":
                    break
                time.sleep(0.25)
                previous, state = state, queue.status(job)
                if (state["state"], state["ahead"]) != (previous["state"], previous["ahead"]):
                    break
            chunk = b""
            if log.is_file():
                with open(log, "rb") as content:
                    content.seek(offset)
                    chunk = content.read(256 * 1024)
                # Send whole lines while the job is still writing.
                if state["state"] != "done" and b"\n" in chunk:
                    chunk = chunk[:chunk.rindex(b"\n") + 1]
            return {**state, "log": chunk.decode(errors="replace"), "offset": offset + len(chunk)}

        def handle_request(self, method):
            parsed = urllib.parse.urlsplit(self.path)
            pieces = parsed.path.strip("/").split("/")
            query = urllib.parse.parse_qs(parsed.query)
            try:
                if method == "GET" and pieces == ["health"]:
                    if daemon.poll() is not None:
                        fail("rsync service stopped")
                    with tempfile.NamedTemporaryFile(dir=root) as probe:
                        probe.write(b"ok")
                        probe.flush()
                    self.respond(200, {"root": str(root), "rsync": "ready"})
                elif method == "POST" and len(pieces) == 2 and pieces[0] == "prepare" and SAFE_NAME.fullmatch(pieces[1]):
                    worker_prepare(root / "projects" / pieces[1])
                    (root / "reports" / pieces[1]).mkdir(parents=True, exist_ok=True)
                    self.respond(200, {"prepared": pieces[1]})
                elif method == "POST" and len(pieces) == 2 and pieces[0] == "clean" and SAFE_NAME.fullmatch(pieces[1]):
                    clean_runs(root / "projects" / pieces[1] / "runs")
                    if query.get("ota", ["1"])[0] == "1":
                        ota = root / "ota" / pieces[1]
                        (ota / "current.ipa").unlink(missing_ok=True)
                        (ota / "current.json").unlink(missing_ok=True)
                        (ota / "icon.png").unlink(missing_ok=True)
                    self.respond(200, {"cleaned": pieces[1]})
                elif method == "POST" and len(pieces) == 3 and pieces[0] == "jobs" and SAFE_NAME.fullmatch(pieces[1]):
                    length = int(self.headers.get("Content-Length", "0"))
                    request = json.loads(self.rfile.read(length)) if 0 < length <= 65536 else {}
                    fingerprint = request.get("fingerprint")
                    if fingerprint is not None and not re.fullmatch(r"[a-f0-9]{64}", str(fingerprint)):
                        fail("Invalid source fingerprint")
                    self.respond(200, queue.submit(pieces[1], pieces[2], request.get("steps", []),
                                                   request.get("command"), bool(request.get("retest")),
                                                   fingerprint))
                elif method == "GET" and len(pieces) == 2 and pieces[0] == "jobs":
                    state = self.job_status(pieces[1], query)
                    self.respond(200 if state else 404, state or {"error": "unknown job; the Mac service may have restarted"})
                elif method == "POST" and len(pieces) == 3 and pieces[0] == "jobs" and pieces[2] == "cancel":
                    self.respond(200, {"cancelled": queue.cancel(pieces[1])})
                elif method == "GET" and pieces == ["queue"]:
                    self.respond(200, {"jobs": queue.snapshot()})
                elif method == "POST" and len(pieces) == 2 and pieces[0] == "reports-clear" and SAFE_NAME.fullmatch(pieces[1]):
                    shutil.rmtree(root / "reports" / pieces[1], ignore_errors=True)
                    self.respond(200, {"cleared": pieces[1]})
                elif method == "POST" and len(pieces) == 3 and pieces[0] in ("build", "test") and SAFE_NAME.fullmatch(pieces[1]):
                    # Clients from before the queue API hold this request open for the whole job.
                    queue.submit(pieces[1], pieces[2], [pieces[0]], retest=True)
                    self.respond(200, {"exit_code": queue.wait(pieces[2])})
                elif method == "POST" and len(pieces) == 3 and pieces[0] == "publish" and SAFE_NAME.fullmatch(pieces[1]):
                    self.respond(200, worker_publish(root, pieces[1], pieces[2]))
                else:
                    self.respond(404, {"error": "unknown request"})
            except Exception as error:
                self.respond(500, {"error": str(error)})

        def do_GET(self):
            self.handle_request("GET")

        def do_POST(self):
            self.handle_request("POST")

    # Bind first: a second copy of the service must fail here, before it touches
    # scratch directories that the running copy's jobs are using.
    server = ThreadingHTTPServer(("127.0.0.1", API_PORT), Handler)
    config = root / "rsyncd.conf"
    config.write_text(f"[gala]\npath = {root}\nread only = no\nuse chroot = no\nlist = no\nhosts allow = 127.0.0.1\n")
    daemon = subprocess.Popen(["/usr/bin/rsync", "--daemon", "--no-detach",
                               "--address=127.0.0.1", f"--port={RSYNC_PORT}",
                               f"--config={config}"], stdout=subprocess.DEVNULL,
                              stderr=subprocess.STDOUT)
    for scratch in ("signing", "tmp"):
        shutil.rmtree(root / scratch, ignore_errors=True)
    reset_cache_for_toolchain(root)
    queue = JobQueue(root)
    housekeeping(root, queue)
    threading.Thread(target=expiration_loop, args=(root, queue), daemon=True).start()
    threading.Thread(target=ota_service, args=(root,), daemon=True).start()
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        server.serve_forever()
    finally:
        with queue.lock:
            running = queue.jobs.get(queue.current) if queue.current else None
            if running and running["process"]:
                stop_process_group(running["process"])
        daemon.terminate()


def add_remote_options(cmd):
    cmd.add_argument("--host", default=os.environ.get("GALA_HOST", "macbook"))
    cmd.add_argument("--root", default=os.environ.get("GALA_REMOTE_ROOT", DEFAULT_ROOT))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="action", required=True)
    for action in ("doctor", "sync", "test", "build", "run", "deliver", "exec"):
        cmd = sub.add_parser(action)
        add_remote_options(cmd)
        if action != "doctor":
            cmd.add_argument("--name", help="stable name for this Mac-side project mirror")
            cmd.add_argument("--checksum", action="store_true", help="compare file contents during sync")
            cmd.add_argument("--dry-run", action="store_true", help="show sync changes without building")
            cmd.add_argument("--json", action="store_true",
                             help="print only a final JSON summary on stdout; progress goes to stderr")
        if action == "run":
            cmd.add_argument("--udid", help="select a device when more than one is connected")
            cmd.add_argument("--p12", help="Apple development certificate and private key")
            cmd.add_argument("--profile", help="matching .mobileprovision file")
        if action in ("build", "run"):
            cmd.add_argument("--gate", action="store_true", help="require ios-test.sh to pass before building")
        if action in ("build", "run", "deliver"):
            cmd.add_argument("--retest", action="store_true",
                             help="run ios-test.sh even if it passed on this exact source")
        if action == "build":
            cmd.add_argument("--deliver", action="store_true", help="test, build, sign on Mac, and publish for OTA install")
        if action == "exec":
            cmd.add_argument("--no-sync", action="store_true", help="run on the existing Mac mirror without syncing")
            cmd.add_argument("command", nargs=argparse.REMAINDER,
                             help="shell command to run in the Mac mirror; write files to $GALA_ARTIFACT_DIR")
    publish = sub.add_parser("publish", aliases=["push"],
                             help="sign and deliver an existing IPA; no build recipe required")
    publish.add_argument("ipa", nargs="?", help="IPA path; defaults to latest Gala Engine build")
    add_remote_options(publish)
    publish.add_argument("--name", help="stable delivery name, also usable across clients")
    publish.add_argument("--json", action="store_true")
    queue = sub.add_parser("queue", help="show jobs running or waiting on the Mac")
    add_remote_options(queue)
    reports = sub.add_parser("reports", help="fetch logs, screenshots, and crashes sent by the installed app")
    add_remote_options(reports)
    reports.add_argument("--name")
    reports.add_argument("--clear", action="store_true", help="delete the Mac's copies after fetching")
    watch = sub.add_parser("watch", help="rerun a Gala action after source edits")
    watch.add_argument("--action", dest="mode", choices=("test", "build", "run", "deliver"), default="run")
    add_remote_options(watch)
    watch.add_argument("--name")
    watch.add_argument("--checksum", action="store_true")
    watch.add_argument("--gate", action="store_true")
    watch.add_argument("--interval", type=float, default=1.0)
    watch.add_argument("--debounce", type=float, default=0.75)
    service = sub.add_parser("mac-service", help="run the Mac-side build and rsync service")
    service.add_argument("--root", default=os.environ.get("GALA_REMOTE_ROOT", DEFAULT_ROOT))
    device = sub.add_parser("device", help="list, pair, and inspect USB iPhone/iPad devices")
    device.add_argument("operation", choices=("list", "pair", "doctor"))
    device.add_argument("--udid", help="select a device when more than one is connected")
    deploy = sub.add_parser("deploy", help="sign an IPA on Linux and install it over USB")
    deploy.add_argument("ipa", nargs="?", help="IPA path; defaults to the latest Gala Engine build")
    deploy.add_argument("--udid", help="select a device when more than one is connected")
    deploy.add_argument("--p12", help="Apple development certificate and private key")
    deploy.add_argument("--profile", help="matching .mobileprovision file")
    options = parser.parse_args(['run'] if len(sys.argv) == 1 else None)
    # A killed client (agent timeout, closed terminal) cancels its Mac job like Ctrl-C does.
    for number in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(number, interrupt)
    json_out = None
    if getattr(options, "json", False):
        # Recipe output and rsync/curl children inherit stdout, so point it at stderr.
        sys.stdout.flush()
        json_out = os.fdopen(os.dup(1), "w")
        os.dup2(2, 1)
    summary = {"action": options.action, "ok": False, "timings": {}}
    started = time.monotonic()
    code = 1
    try:
        if options.action == "doctor":
            client_doctor(options)
        elif options.action == "mac-service":
            mac_service(options.root)
        elif options.action == "device":
            device_action(options)
        elif options.action == "deploy":
            client_deploy(options)
        elif options.action == "queue":
            client_queue(options)
        elif options.action == "reports":
            client_reports(options)
        elif options.action in ("publish", "push"):
            client_publish(options, summary)
        elif options.action == "watch":
            validate_options(options)
            if options.interval <= 0 or options.debounce <= 0:
                fail("Watch interval and debounce must be positive")
            client_watch(options)
        else:
            client_project_action(options, summary)
        code = summary.get("exit_code", 0)
        summary["ok"] = code == 0
    except KeyboardInterrupt:
        print("Interrupted", file=sys.stderr)
        summary["error"] = "interrupted"
        code = 130
    except (RuntimeError, subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError,
            zipfile.BadZipFile, ValueError, KeyError) as error:
        print(f"gala: {error}", file=sys.stderr)
        summary["error"] = str(error)
    if options.action in ("sync", "test", "build", "run", "deliver", "exec", "publish", "push"):
        summary["timings"]["total"] = round(time.monotonic() - started, 1)
        report_summary(summary, json_out)
    return code


def interrupt(*_):
    raise KeyboardInterrupt


def report_summary(summary, json_out):
    order = ("prepare", "sync", "upload", "queue", "test", "build", "exec", "fetch", "deploy", "publish")
    timings = summary["timings"]
    parts = [f"{key} {timings[key]}s" for key in order if key in timings]
    parts += [f"{step} skipped (source unchanged)" for step in summary.get("skipped", [])]
    verdict = "passed" if summary["ok"] else "failed"
    print(f"Summary: {summary['action']} {verdict} in {timings['total']}s"
          + (f" ({', '.join(parts)})" if parts else ""), flush=True)
    if summary.get("source"):
        path = Path(summary["source"]) / ".gala" / "last-result.json"
        path.parent.mkdir(exist_ok=True)
        path.write_text(json.dumps(summary, indent=2) + "\n")
    if json_out:
        json_out.write(json.dumps(summary) + "\n")
        json_out.flush()


class phase:
    """Record how long one client step takes in the run summary."""

    def __init__(self, summary, name):
        self.summary, self.name = summary, name

    def __enter__(self):
        self.started = time.monotonic()

    def __exit__(self, *_):
        self.summary["timings"][self.name] = round(time.monotonic() - self.started, 1)


def client_project_action(options, summary):
    validate_options(options)
    source, name, remote_project = project_paths(options)
    summary.update(project=name, source=str(source))
    action = options.action
    acting = action != "sync" and not options.dry_run
    if action == "exec" and not options.command:
        fail("Pass a command: gala exec -- <command>")
    if action == "run":
        # Check before a full build rather than failing at the very end.
        require_deploy_tools()
        select_device(options.udid)
    steps = {"exec": ["exec"], "test": ["test"]}.get(action, [])
    if action == "deliver" or getattr(options, "gate", False) or getattr(options, "deliver", False):
        steps.append("test")
    if action in ("build", "run", "deliver"):
        steps.append("build")
    lock_dir = source / ".gala"
    lock_dir.mkdir(exist_ok=True)
    with open(lock_dir / "client.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with phase(summary, "prepare"):
            prepare(options, remote_project)
            if acting:
                # Tests and exec keep the current delivery installable.
                clear_ota = "0" if set(steps) <= {"test", "exec"} else "1"
                service_request(options.host, "POST", f"clean/{name}?ota={clear_ota}", capture_output=True)
                clean_runs(source / ".gala" / "runs")
        if not getattr(options, "no_sync", False):
            with phase(summary, "sync"):
                sync(options, source, remote_project)
        if not acting:
            return
        command = None
        if action == "exec":
            command = options.command[1:] if options.command[0] == "--" else options.command
            command = command[0] if len(command) == 1 else shlex.join(command)
        retest = action == "test" or getattr(options, "retest", False)
        fingerprint = (hashlib.sha256(repr(source_snapshot(source)).encode()).hexdigest()
                       if "test" in steps else None)
        client_job(options, source, remote_project, steps, summary, command, retest, fingerprint)
        if summary.get("exit_code"):
            return
        if action == "run":
            options.ipa = None
            with phase(summary, "deploy"):
                client_deploy(options)
        elif action == "deliver" or getattr(options, "deliver", False):
            with phase(summary, "publish"):
                client_publish_job(options, source, remote_project, summary["job"], summary)


def service_json(host, method, path, data=None, attempts=1):
    """Call the Mac service and parse its JSON reply, retrying brief network drops."""
    extra = ["-H", "Content-Type: application/json", "--data-binary", "@-"] if data is not None else []
    for attempt in range(attempts):
        result = remote(host, "curl", "--fail-with-body", "-sS", "-X", method, *extra,
                        f"http://127.0.0.1:{API_PORT}/{path}", check=False, capture_output=True, text=True,
                        input=json.dumps(data) if data is not None else None)
        try:
            reply = json.loads(result.stdout)
        except ValueError:
            reply = {"error": result.stderr.strip() or result.stdout.strip() or "no reply"}
        if result.returncode == 0:
            return reply
        # curl exits 22 when the service answered with an HTTP error; anything else is transport.
        if result.returncode == 22:
            if "unknown request" in str(reply.get("error")):
                fail("The Mac service is older than this client; update service.py and restart it")
            fail(f"Mac service: {reply.get('error')}")
        if attempt < attempts - 1:
            time.sleep(2)
    fail(f"Mac service unreachable: {reply.get('error')}")


def new_job_id():
    return dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + uuid.uuid4().hex[:6]


def client_job(options, source, remote_project, steps, summary, command=None, retest=False, fingerprint=None):
    """Queue a job on the Mac, stream its output, and fetch its run directory."""
    name = remote_project.rsplit("/", 1)[-1]
    job = new_job_id()
    summary["job"] = job
    state = service_json(options.host, "POST", f"jobs/{name}/{job}",
                         {"steps": steps, "command": command, "retest": retest, "fingerprint": fingerprint})
    print(f"Queued {'+'.join(steps)} on {options.host} (job {job})", flush=True)
    offset, ahead = 0, None
    try:
        while True:
            if state["state"] == "queued" and state["ahead"] and state["ahead"] != ahead:
                ahead = state["ahead"]
                print(f"Queue position {ahead + 1}: waiting for {state.get('blocked_by', 'earlier jobs')}"
                      + (f" and {ahead - 1} more" if ahead > 1 else ""), flush=True)
            elif state["state"] != "queued" and ahead:
                print(f"Started after {state['waited']}s in queue", flush=True)
                ahead = 0
            sys.stdout.write(state.get("log", ""))
            sys.stdout.flush()
            offset = state.get("offset", offset)
            if state["state"] == "done":
                break
            state = service_json(options.host, "GET", f"jobs/{job}?offset={offset}&wait=15", attempts=5)
    except KeyboardInterrupt:
        remote(options.host, "curl", "-sS", "-X", "POST", f"http://127.0.0.1:{API_PORT}/jobs/{job}/cancel",
               check=False, capture_output=True)
        raise
    summary["timings"]["queue"] = state["waited"]
    summary["timings"].update(state["timings"])
    summary["skipped"] = state["skipped"]
    destination = source / ".gala" / "runs" / job
    destination.mkdir(parents=True, exist_ok=True)
    with phase(summary, "fetch"):
        try:
            rsync_command(options, "-a", daemon_url(f"{remote_project}/runs/{job}/"), f"{destination}/")
        except subprocess.CalledProcessError:
            fail(f"Mac job {job} ended without a result")
    manifest = json.loads((destination / "result.json").read_text())
    summary["run_dir"] = str(destination)
    summary["logs"] = [str(destination / f"{step}.log") for step in steps if (destination / f"{step}.log").is_file()]
    summary["artifacts"] = [{**artifact, "path": str(destination / artifact["path"])}
                            for artifact in manifest["artifacts"]]
    summary["exit_code"] = manifest["exit_code"]
    for log in summary["logs"]:
        print(f"Log: {log}")
    for artifact in summary["artifacts"]:
        print(f"IPA: {artifact['path']}")
        print(f"SHA-256: {artifact['sha256']}")
    if steps == ["exec"]:
        files = [path for path in destination.rglob("*") if path.is_file()
                 and path.name not in ("result.json", "output.log", "exec.log")]
        summary["files"] = [str(path) for path in sorted(files)]
        if files:
            print(f"Files from $GALA_ARTIFACT_DIR: {destination}")
        if manifest["exit_code"]:
            print(f"Command exited with status {manifest['exit_code']}", file=sys.stderr)
        return job
    if manifest["exit_code"]:
        failed = next(reversed(manifest["timings"]), None) or next(
            (step for step in steps if step not in manifest["skipped"]), steps[-1])
        fail(f"{failed.title()} failed; inspect {destination / f'{failed}.log'}")
    return job


def client_publish_job(options, source, remote_project, job, summary):
    name = remote_project.rsplit("/", 1)[-1]
    details = service_json(options.host, "POST", f"publish/{name}/{job}")
    if "install_url" not in details:
        fail("Mac published the build but could not read its Tailscale name; check tailscale status on the Mac")
    install, ipa_url = details["install_url"], details["ipa_url"]
    for url in (install, ipa_url):
        if remote(options.host, "curl", "-fsSI", url, check=False, capture_output=True).returncode:
            fail(f"Published, but {url} does not answer over HTTPS; check tailscale serve on the Mac")
    result = {"ipa": ipa_url, "install": install, **details}
    path = source / ".gala" / "current-publish.json"
    path.parent.mkdir(exist_ok=True)
    path.write_text(json.dumps(result, indent=2) + "\n")
    summary.update(install_url=install, ipa_url=ipa_url, title=details["title"],
                   version=details["version"], sha256=details["sha256"])
    print(f"Delivered {details['title']} build {details['version']}: {install}")


def client_publish(options, summary):
    validate_options(options)
    source, name, remote_project = project_paths(options, require_recipe=not bool(options.ipa))
    summary.update(project=name, source=str(source))
    lock_dir = source / ".gala"
    lock_dir.mkdir(exist_ok=True)
    with open(lock_dir / "client.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        ipa = Path(options.ipa).expanduser().resolve() if options.ipa else latest_ipa()
        if not ipa.is_file() or ipa.suffix.lower() != ".ipa":
            fail(f"IPA not found: {ipa}")
        with zipfile.ZipFile(ipa) as archive:
            if archive.testzip() or not any(name.startswith("Payload/") and ".app/" in name for name in archive.namelist()):
                fail(f"Invalid IPA: {ipa}")
        with phase(summary, "prepare"):
            prepare(options, remote_project)
        incoming = f"{remote_project}/incoming/"
        with phase(summary, "upload"):
            rsync_command(options, "-a", str(ipa), daemon_url(incoming + "current.ipa"))
        with phase(summary, "publish"):
            client_publish_job(options, source, remote_project, "incoming", summary)


def client_queue(options):
    validate_options(options)
    jobs = service_json(options.host, "GET", "queue")["jobs"]
    if not jobs:
        print("The Mac is idle")
    for item in jobs:
        timing = (f"running {item['running_for']}s" if item["state"] == "running"
                  else f"waiting {item['waited']}s, {item['ahead']} ahead")
        print(f"{item['job']}  {item['project']}  {'+'.join(item['steps'])}  {timing}")


def client_reports(options):
    validate_options(options)
    source, name, remote_project = project_paths(options)
    prepare(options, remote_project)
    destination = source / ".gala" / "reports"
    destination.mkdir(parents=True, exist_ok=True)
    rsync_command(options, "-a", daemon_url(f"reports/{name}/"), f"{destination}/")
    if options.clear:
        service_json(options.host, "POST", f"reports-clear/{name}")
    reports = sorted((path for path in destination.iterdir() if path.is_file()), reverse=True)
    if not reports:
        print("No reports yet. Add GalaReporter.swift to the app and deliver it with gala deliver.")
    for path in reports:
        print(f"{path}  {path.stat().st_size} bytes")


if __name__ == "__main__":
    sys.exit(main())
